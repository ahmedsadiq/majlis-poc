# Server-side only. Never commit real values.
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
# Optional: lets the server mint short-lived Deepgram keys instead of exposing the main key to the browser.
# Find it in console.deepgram.com -> Projects -> (your project) -> Project ID
DEEPGRAM_PROJECT_ID=
# Hard cap per live session in minutes (credit protection). Default 15.
LIVE_SESSION_CAP_MINUTES=15
